*** /dev/null
--- b/TP2_Exchanges/include/tp2_exchanges/transport_types.hpp
@@
+#pragma once
+#include <string>
+#include <string_view>
+#include <cstdint>
+#include <chrono>
+#include <functional>
+#include <optional>
+#include <vector>
+#include <utility>
+#include <compare>
+
+namespace tp2::exchanges {
+
+using Clock      = std::chrono::steady_clock;
+using SysClock   = std::chrono::system_clock;
+using TimePoint  = Clock::time_point;
+using SysTime    = SysClock::time_point;
+
+enum class Channel : uint8_t { OrderBook, Trades, Ticker };
+enum class Depth   : uint16_t { L1=1, L5=5, L50=50, Full=0 };
+
+struct SubscriptionKey {
+  Channel     channel{};
+  std::string symbol;       // normalized, e.g. "BTCUSDT"
+  Depth       depth{Depth::L50};
+  bool operator==(const SubscriptionKey& o) const noexcept {
+    return channel==o.channel && depth==o.depth && symbol==o.symbol;
+  }
+};
+
+struct SubscriptionId {
+  uint64_t value{0};
+  auto operator<=>(const SubscriptionId&) const = default;
+  explicit operator bool() const noexcept { return value!=0; }
+};
+
+struct Health {
+  bool online{false};
+  std::optional<SysTime> last_heartbeat;
+  std::optional<std::chrono::milliseconds> rtt;
+  uint64_t reconnects{0};
+};
+
+// DTO (минимум, чтобы изолировать транспорт)
+struct OrderBookDelta {
+  std::string symbol;
+  uint64_t    seq{0};
+  SysTime     exchange_ts{};
+  // price, qty, side(+1 bid / -1 ask / 0 remove)
+  std::vector<std::tuple<double,double,int8_t>> changes;
+};
+
+struct OrderBookSnapshot {
+  std::string symbol;
+  uint64_t    seq{0};
+  SysTime     exchange_ts{};
+  std::vector<std::pair<double,double>> bids; // price, qty
+  std::vector<std::pair<double,double>> asks;
+};
+
+struct TradeTick {
+  std::string symbol;
+  SysTime     exchange_ts{};
+  double      price{};
+  double      qty{};
+  bool        is_buy{}; // taker side
+};
+
+struct Ticker {
+  std::string symbol;
+  SysTime     exchange_ts{};
+  double      last{};
+  double      best_bid{};
+  double      best_ask{};
+  double      volume24h{};
+};
+
+} // namespace tp2::exchanges
